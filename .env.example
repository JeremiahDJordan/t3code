# Optional build and run configuration for the fork (`cp .env.example .env`).
# Every service that talks to a web service is off while its variables are
# unset; uncomment one only to give it a value. Upstream's own values (its Clerk
# instance, relay, hosted app, PostHog project, release repository and mobile
# accounts) are deliberately not here: point each one at a server of your own
# to turn it on. FORK.md, "Talk to no T3 web service", has the list. Do not add
# server-side secrets to this file.

# T3 Connect, only with T3_CONNECT_ENABLED in packages/shared/src/forkFeatures.ts.
# Your own Clerk instance: from the Clerk Dashboard under API keys, JWT templates,
# and OAuth applications.
# T3CODE_CLERK_PUBLISHABLE_KEY=
# T3CODE_CLERK_JWT_TEMPLATE=
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in T3CODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t3code.provisionprofile
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Your own relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
# T3CODE_RELAY_URL=

# Your own hosted web app origin (the CLI's out-of-band OAuth flow, and hosted
# pairing and prompt links in the web app). Empty means none.
# T3CODE_HOSTED_APP_URL=
# VITE_HOSTED_APP_URL=

# Product analytics: your own PostHog project. Both empty sends nothing.
# T3CODE_POSTHOG_KEY=
# T3CODE_POSTHOG_HOST=

# Newer model manifests: a URL serving model-manifest.json. Empty uses the bundled copy.
# T3CODE_MODEL_MANIFEST_URL=

# Release downloads (`t3 update`, the background service, server updates started
# from a client, and an SSH host's runtime): your own GitHub repository
# (owner/name) or a download base URL. Both empty downloads nothing.
# T3CODE_RELEASE_REPOSITORY=
# T3CODE_RELEASE_BASE_URL=

# Web and desktop: release pages linked from the desktop's update notes
# (owner/name), the npm package a client checks before offering a server update
# (a registry URL such as https://registry.npmjs.org/<name>), and a privacy policy.
# VITE_T3CODE_RELEASE_REPOSITORY=
# VITE_T3CODE_NPM_PACKAGE_URL=
# VITE_PRIVACY_POLICY_URL=

# `t3 triage`: your own fork on GitHub (owner/name), whose playbook it follows
# and where it files issues. Empty turns triage off.
# T3CODE_TRIAGE_REPOSITORY=

# Mobile builds (apps/mobile/app.config.ts): your own EAS project and owner, or
# an updates URL, for over-the-air updates; your Apple team for signing; and a
# site for the legal pages. The release repository (owner/name) is where a
# server's "check for updates" looks.
# T3CODE_EAS_PROJECT_ID=
# T3CODE_EAS_OWNER=
# T3CODE_MOBILE_UPDATES_URL=
# T3CODE_APPLE_TEAM_ID=
# EXPO_PUBLIC_MARKETING_SITE_URL=
# EXPO_PUBLIC_T3CODE_RELEASE_REPOSITORY=

# Public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.example.com/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=
